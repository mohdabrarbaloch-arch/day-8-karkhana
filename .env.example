# ───────────────────────────────────────────────────────────
# Karkhana — environment configuration
# Copy to .env and fill in. Nothing here ships a real secret.
# ───────────────────────────────────────────────────────────

# --- Core ---
APP_NAME=Karkhana
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. The app refuses to boot with the default value
# when ENVIRONMENT=production.
SECRET_KEY=dev-only-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
ALGORITHM=HS256

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./karkhana.db
# PostgreSQL (docker-compose provides this):
# DATABASE_URL=postgresql+psycopg://karkhana:karkhana@localhost:5432/karkhana

# --- CORS ---
# Comma-separated. Use explicit origins in production, never "*".
CORS_ORIGINS=*

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Cluster economics ---
# Blended $/GPU-hour used for chargeback across the default cluster.
DEFAULT_COST_PER_GPU_HOUR=2.50

# --- Scheduler defaults ---
# Priority ageing: every N minutes a queued job gains +1 priority (capped).
AGING_MINUTES=30
# Turn EASY backfill on or off cluster-wide.
ENABLE_BACKFILL=true

# --- Seeding ---
# Load the demo cluster + jobs on first boot. Set false in production.
ALLOW_DEMO_SEED=true
